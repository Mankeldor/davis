{#
  What a scheduling email says. `action` is one of REQUEST (invitation), UPDATE (changed
  invitation), CANCEL (event canceled), UNINVITED (the recipient was removed from it), ACCEPTED,
  TENTATIVE, DECLINED (replies). The variables are listed in the README.
#}
{% extends 'layout.html.twig' %}

{% block header %}
    <tr>
      <td width="*"> </td>
      <td width="500">
        <table width="100%">
          <tr>
            <td width="1" style="font-size: 64px; font-weight:bold;">{{ when.day }}</td>
            <td width="*" style="padding: 10px 0;">
              <span style=" font-size: 12px; color: #555555">{{ when.weekday }}</span><br />
              {{ when.month }}
            </td>
            <td width="58" style="text-align: right;">
            </td>
          </tr>
        </table>
      </td>
      <td width="*"> </td>
    </tr>
    <tr>
      <td> </td>
      <td style="border-top: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
{% endblock %}

{% block content %}
    <tr>
      <td> </td>
      <td style="text-align: center; padding: 10px 0;">
        {{ t('heading.' ~ action|lower, {name: senderName}) }}
        <h1 style="margin: 0; color: {{ brand.accentColor }}; font-weight: 300; line-height: 36px;">{{ summary }}</h1>
      </td>
      <td> </td>
    </tr>
    <tr>
      <td colspan="3"> </td>
    </tr>
    <tr>
      <td> </td>
      <td style="border-top: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
    <tr>
      <td> </td>
      <td>
        <table border="0" cellpadding="0" cellspacing="10" width="100%">
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">{{ t('label.when') }}</td>
            <td>
              <strong>{{ when.date }}</strong>
              {% if when.time %}<br /><strong>{{ when.time }}</strong>{% endif %}
              {% if recurring %}<br />{{ t('when.recurring') }}{% endif %}
            </td>
          </tr>
          {% if action not in ['CANCEL', 'UNINVITED'] %}
            <tr>
              <td style="vertical-align: top; color: #777777;" width="100px">{{ t('label.attendees') }}</td>
              <td>
              {% for attendee in attendees %}
                {% if attendee.email %}<a href="mailto:{{ attendee.email }}" style="color: {{ brand.accentColor }}">{{ attendee.cn }}</a>{% else %}{{ attendee.cn }}{% endif %}
                {% if attendee.role == 'CHAIR' %}{{ t('label.organizer') }}{% endif %}
                <br />
              {% endfor %}
              </td>
            </tr>
          {% endif %}
          {% if location %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">{{ t('label.where') }}</td>
            <td>{{ location|nl2br }}</td>
          </tr>
          {% endif %}
          {% if locationImageDataAsBase64 %}
          <tr>
            <td colspan="2">
                <a href="{{ locationLink }}" title="{{ t('label.map') }}">
                  <img src="data:image/png;base64,{{ locationImageDataAsBase64 }}" width="100%"/>
                </a>
            </td>
          </tr>
          {% endif %}
          {% if url %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">{{ t('label.url') }}</td>
            <td>
              <a href="{{ url }}" style="color: #aaaaaa">{{ url }}</a>
            </td>
          </tr>
          {% endif %}
          {% if description %}
          <tr>
            <td style="vertical-align: top; color: #777777;" width="100px">{{ t('label.notes') }}</td>
            <td>{{ description|nl2br }}</td>
          </tr>
          {% endif %}
        </table>
      </td>
      <td> </td>
    </tr>
    {% if attached and action in ['REQUEST', 'UPDATE'] %}
    <tr>
      <td> </td>
      <td style="padding: 0 10px 10px 10px; color: #555555;">{{ t('hint.reply') }}</td>
      <td> </td>
    </tr>
    {% endif %}
    <tr>
      <td> </td>
      <td style="border-bottom: 1px solid #cccccc"> </td>
      <td> </td>
    </tr>
{% endblock %}

        <target>To reply, open the attached invitation in your calendar app.</target>
      </trans-unit>
      <trans-unit id="mail032" resname="footer.unbranded">
        <source>footer.unbranded</source>
        <target>Mail sent by {site}</target>
      </trans-unit>
      <trans-unit id="mail033" resname="footer.branded">
        <source>footer.branded</source>
        <target>{brand} sent this message on behalf of {name}. Replies go to {name}.</target>
      </trans-unit>
      <trans-unit id="mail034" resname="footer.reply">
        <source>footer.reply</source>
        <target>Replies go to {name}.</target>
      </trans-unit>
